<Window x:Class="GlassTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Translate" Icon="pack://application:,,,/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" ThemeMode="Dark"
        MinWidth="300" MinHeight="180" Width="900" Height="480">
    <!-- The 1/255-alpha outer band is invisible but still catches the mouse, giving a wide resize edge.
         Fully transparent pixels (the middle) let clicks and scrolling through to the window underneath. -->
    <Border BorderBrush="#01FFFFFF" BorderThickness="5">
        <!-- Dark hairline outside the accent line keeps the frame visible on light and dark pages alike. -->
        <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="13">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="12">
                <Grid x:Name="Root">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ToolBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10,10,0,0"
                            Padding="6,5,4,5" MouseLeftButtonDown="OnDragArea">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="TranslateButton" Style="{StaticResource AccentToolButton}" Content="&#xE72C;" Click="OnTranslateNow" />
                                <ToggleButton x:Name="OriginalToggle" Style="{StaticResource ToolButton}" Content="&#xE890;"
                                              Checked="OnOriginalToggled" Unchecked="OnOriginalToggled" />
                                <ToggleButton x:Name="PinToggle" Style="{StaticResource ToolButton}" Content="&#xE718;"
                                              Checked="OnPinToggled" Unchecked="OnPinToggled" />
                                <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Content="&#xE713;" Click="OnSettings" />
                                <Button x:Name="HelpButton" Style="{StaticResource ToolButton}" Content="&#xE897;" Click="OnHelp" />
                                <Button x:Name="TourButton" Style="{StaticResource ToolButton}" Content="&#xE7BE;" Click="OnTour" />
                                <Button x:Name="DonateButton" Style="{StaticResource ToolButton}" Content="&#xEB51;" Click="OnDonate"
                                        Foreground="#FF6B8B" />
                                <Rectangle Style="{StaticResource Divider}" />
                                <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" />
                                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" />
                                <Button x:Name="CloseButton" Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Click="OnClose" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                <Border x:Name="LogoBadge" Width="26" Height="26" Margin="0,0,6,0"
                                        VerticalAlignment="Center" ToolTip="Glass Translate">
                                    <Image Source="pack://application:,,,/app.ico" Width="24" Height="24"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <ComboBox x:Name="SourceBox" Width="140" SelectionChanged="OnLanguageChanged" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <ComboBox x:Name="TargetBox" Width="130" SelectionChanged="OnLanguageChanged" />
                                <Rectangle Style="{StaticResource Divider}" />
                                <ComboBox x:Name="EngineBox" Width="140" SelectionChanged="OnEngineChanged" />
                                <ComboBox x:Name="IntervalBox" Width="132" SelectionChanged="OnIntervalChanged" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="Hole" Grid.Row="1" />

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10"
                            Padding="10,3,3,3" MouseLeftButtonDown="OnDragArea">
                        <DockPanel>
                            <!-- Resize handle: WndProc reports the bottom-right corner while the mouse is over it. -->
                            <Border x:Name="ResizeGrip" DockPanel.Dock="Right" Width="18" Height="18" Background="Transparent"
                                    Cursor="SizeNWSE" VerticalAlignment="Bottom">
                                <Path Data="M12,2 L12,4 L10,4 L10,2 Z M12,6 L12,8 L10,8 L10,6 Z M8,6 L8,8 L6,8 L6,6 Z M12,10 L12,12 L10,12 L10,10 Z M8,10 L8,12 L6,12 L6,10 Z M4,10 L4,12 L2,12 L2,10 Z"
                                      Fill="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Grid x:Name="StatusInfo">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TextDimBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Width="250">
                            <StackPanel>
                                <TextBlock x:Name="FontLabel" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FontBox" Margin="0,0,0,12" SelectionChanged="OnFontChanged" />
                                <TextBlock x:Name="FontSizeLabel" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FontSizeBox" Margin="0,0,0,12" SelectionChanged="OnFontChanged" />
                                <TextBlock x:Name="UiLanguageLabel" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="UiLanguageBox" Margin="0" SelectionChanged="OnUiLanguageChanged" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12" Width="360">
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HelpPanel" />
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <Popup x:Name="DonatePopup" PlacementTarget="{Binding ElementName=DonateButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Width="270">
                            <StackPanel>
                                <TextBlock x:Name="DonateTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="DonateText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,10"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <Button x:Name="KofiButton" Style="{StaticResource DonateOption}" Tag="https://ko-fi.com/dmakhazen" Click="OnDonateLink">
                                    <StackPanel>
                                        <TextBlock Text="Ko-fi" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock x:Name="KofiHint" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BoostyButton" Style="{StaticResource DonateOption}" Tag="https://boosty.to/dmakhazen/donate" Click="OnDonateLink"
                                        Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Boosty" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock x:Name="BoostyHint" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Onboarding tour: dims everything except the highlighted control and explains it in a card. -->
                    <Grid x:Name="TourLayer" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100"
                          KeyDown="OnTourKey" Focusable="True">
                        <Path x:Name="TourDim" Fill="#B8000000" />
                        <Border x:Name="TourHighlight" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                        <Border x:Name="TourCard" Width="290" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock x:Name="TourStep" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="TourTitle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,2,0,4" TextWrapping="Wrap" />
                                <TextBlock x:Name="TourText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button x:Name="TourSkip" DockPanel.Dock="Left" Style="{StaticResource TextButton}" Click="OnTourSkip" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TourBack" Style="{StaticResource TextButton}" Click="OnTourBack" Margin="0,0,6,0" />
                                        <Button x:Name="TourNext" Style="{StaticResource AccentTextButton}" Click="OnTourNext" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>GlassTranslate</AssemblyName>
    <RootNamespace>GlassTranslate</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Glass Translate</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/make-icon.cs. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <!-- ONNX Runtime links against the VC++ runtime, which a clean Windows may lack: ship it app-local
       (permitted by the Visual C++ redistributable license) so nothing has to be installed. -->
  <ItemGroup>
    <None Include="$(SystemRoot)\System32\msvcp140.dll;$(SystemRoot)\System32\msvcp140_1.dll;$(SystemRoot)\System32\vcruntime140.dll;$(SystemRoot)\System32\vcruntime140_1.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Bundled OCR models: shared detector + Thai, English, Cyrillic and Latin recognizers. Others download on demand. -->
  <ItemGroup>
    <None Include="..\..\models_cache\det\det.onnx" Link="models\det\det.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\thai\rec.onnx" Link="models\thai\rec.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\thai\dict.txt" Link="models\thai\dict.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\english\rec.onnx" Link="models\english\rec.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\english\dict.txt" Link="models\english\dict.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\eslav\rec.onnx" Link="models\eslav\rec.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\eslav\dict.txt" Link="models\eslav\dict.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\latin\rec.onnx" Link="models\latin\rec.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models_cache\latin\dict.txt" Link="models\latin\dict.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
